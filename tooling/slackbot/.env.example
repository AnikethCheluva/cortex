# Slack bot config — copy to .env and fill in. NEVER commit .env (it's gitignored).

# From your Slack app (see README.md):
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Absolute path to your vault checkout (the dir holding sources/ + wiki/).
VAULT_PATH=/absolute/path/to/your-wiki

# The Claude Code binary the bot shells out to.
CLAUDE_BIN=claude

# Commit + push changes the run makes back to the repo.
PUSH_AFTER_WRITE=true
