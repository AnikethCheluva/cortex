# Local content defaults to the EMPTY starter. Explicitly opt into your own vault.
# VAULT_PATH=/absolute/path/to/your-private-vault
# NEXT_PUBLIC_TIME_ZONE=America/New_York

# Hosted write-back: a separate PRIVATE data repo, never the public code repo.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main

# Set login before hosting private data. Unset = open local/demo app.
APP_PASSWORD=
AUTH_SECRET=
ALLOWED_EMAILS=
# APP_ORIGIN=https://your-private-cortex.example.com
API_TOKEN=

# Calendar OAuth public client IDs (configure your own).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_MS_CLIENT_ID=

# Optional local Codex companion; these are SERVER-ONLY secrets/configuration.
CODEX_BRIDGE_URL=
CODEX_BRIDGE_TOKEN=

# Optional transcription fallback. Browser speech may use vendor servers.
STT_API_KEY=
# STT_BASE_URL=https://api.openai.com/v1
# STT_MODEL=whisper-1

# Optional recall ingest tuning.
# QUIZ_TARGET_RETENTION=0.9
# QUIZ_DAILY_CAP=20

# Convex requires separate provider/client authentication; see DEPLOY.md.
# NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
