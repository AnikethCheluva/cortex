# --- Write-back to the vault (set these on Vercel; leave unset for local dev) ---
# When GITHUB_TOKEN + GITHUB_REPO are present the app commits edits (today's
# daily note, task add/toggle) straight to the GitHub repo via the Contents API.
# When they're absent (local `npm run dev`), it writes the local filesystem vault
# instead, so you can develop on the same machine that holds the files.

# Fine-grained Personal Access Token with Contents: Read and write on THIS repo.
GITHUB_TOKEN=

# owner/name of the wiki repo.
GITHUB_REPO=your-username/your-wiki-repo

# Branch to read/commit (the repo the Slack bot pushes to).
GITHUB_BRANCH=main

# Optional: point the app at YOUR vault (the directory holding sources/ + wiki/).
# Unset, the app runs on the bundled examples/vault demo. Set this to your own
# content — e.g. a sibling checkout of your private wiki repo.
# VAULT_PATH=../../my-wiki

# --- Voice notes (speech-to-text) ---
# Voice notes work with NO key on browsers with the Web Speech API (Chrome,
# Safari incl. iOS) — transcription runs on-device for free. These vars are only
# a FALLBACK for browsers without Web Speech; leave blank to skip. OpenAI-
# compatible: set the key for OpenAI, or add the base URL + model for Groq.
# Audio is transcribed and discarded — never stored.
STT_API_KEY=
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_MODEL=whisper-large-v3

# --- Integration API (Raycast / iOS widgets / Shortcuts / any frontend) ---
# Optional shared secret. When set, external clients must send it on WRITE calls
# (Authorization: Bearer <API_TOKEN>); the web app's own same-origin requests
# still work without it, and GET reads stay open. Leave blank = no gate (open,
# current behavior). See web/API.md.
API_TOKEN=

# --- Login (optional) ---
# Set a password to put the whole app behind a sign-in screen. The session is a
# stateless HMAC in an httpOnly cookie, and WRITES are enforced server-side — so
# this is real access control, not a hidden UI. Leave blank = no login (the right
# default for a local clone or a private demo). Changing it signs everyone out.
APP_PASSWORD=
# Your deploy's origin, used to recognize the web app's same-origin writes when
# API_TOKEN is set (usually auto-detected from the Host header; set if needed).
# APP_ORIGIN=https://your-project.vercel.app

# --- Recall quiz (spaced repetition) ---
# NO API KEY. The web app only captures answers and reveals the reference; the
# GRADING + FSRS scheduling + measurements happen in the /ingest (which is Claude
# itself). These vars tune the ingest script (`npm run srs:ingest`), not the app:
# QUIZ_TARGET_RETENTION=0.9   # FSRS desired recall probability (0.80–0.95)
# QUIZ_DAILY_CAP=20           # max questions selected per day

# --- Calendar (Google Calendar + Outlook) ---
# The Calendar tab connects via CLIENT-SIDE OAuth (Google Identity Services +
# MSAL) — no secrets, tokens live in the browser. These are PUBLIC client IDs,
# safe to expose. Set either or both; the tab shows only what's configured.
# Full setup (Google Cloud OAuth client + Azure app registration): web/CALENDAR.md
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# NEXT_PUBLIC_MS_CLIENT_ID=00000000-0000-0000-0000-000000000000

# --- Convex live-mirror (optional) ---
# When set, the web app reads a real-time mirror of the repo from Convex (live
# updates, no redeploy) instead of the build-time snapshot; unset = build-time.
# Get this by running `npx convex dev` in web/ (prints your deployment URL).
# Convex itself needs GITHUB_TOKEN (Contents: Read) + GITHUB_REPO + GITHUB_BRANCH
# set in ITS env (npx convex env set …), so the sync can read the repo.
# NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
